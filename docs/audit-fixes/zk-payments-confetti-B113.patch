+#!/usr/bin/env python3
+"""Lexical guardrail for the Zkpc Lean sources (CI job `guardrails`).
+
+Strips Lean comments (``--`` line comments and nested ``/- ... -/`` block and
+doc comments) and string/char literals, then scans the remaining *code* for:
+
+* ``sorry``, ``admit``, ``native_decide`` anywhere;
+* ``axiom`` declarations outside ``Zkpc/Assumptions.lean``.
+
+Because documentary tokens are removed first, docstrings may mention these
+words.  This is only a fast lexical pre-check: the authoritative dependency
+gate is ``scripts/check-axioms.lean``, which checks the kernel axioms every
+``Zkpc.*`` declaration actually reaches.
+
+Usage: ``python3 scripts/lean_token_scan.py [ROOT]`` (default: repo root).
+Exit status 1 if anything is found.
+"""
+from __future__ import annotations
+
+import re
+import sys
+from pathlib import Path
+
+FORBIDDEN = re.compile(r"(?<![\w.'])(sorry|admit|native_decide)(?![\w'])")
+AXIOM_DECL = re.compile(r"(?<![\w.'])axiom(?![\w'])")
+ALLOWED_AXIOM_FILE = Path("Zkpc/Assumptions.lean")
+
+
+def strip_lean(src: str) -> str:
+    """Replace comments and string/char literals by spaces, keeping newlines."""
+    out = []
+    i, n, depth = 0, len(src), 0
+    while i < n:
+        c = src[i]
+        two = src[i:i + 2]
+        if depth:
+            if two == "/-":
+                depth += 1
+                out.append("  ")
+                i += 2
+            elif two == "-/":
+                depth -= 1
+                out.append("  ")
+                i += 2
+            else:
+                out.append("\n" if c == "\n" else " ")
+                i += 1
+        elif two == "/-":
+            depth = 1
+            out.append("  ")
+            i += 2
+        elif two == "--":
+            j = src.find("\n", i)
+            j = n if j == -1 else j
+            out.append(" " * (j - i))
+            i = j
+        elif c == '"':
+            j = i + 1
+            while j < n and src[j] != '"':
+                j += 2 if src[j] == "\\" else 1
+            j = min(j + 1, n)
+            out.append("".join("\n" if ch == "\n" else " " for ch in src[i:j]))
+            i = j
+        elif c == "'" and re.match(r"'(\\.|[^\\'\n])'", src[i:i + 4]):
+            m = re.match(r"'(\\.|[^\\'\n])'", src[i:i + 4])
+            out.append(" " * m.end())
+            i += m.end()
+        else:
+            out.append(c)
+            i += 1
+    return "".join(out)
+
+
+def scan(root: Path) -> list[str]:
+    files = [root / "Zkpc.lean", *sorted((root / "Zkpc").rglob("*.lean"))]
+    problems = []
+    for f in files:
+        if not f.exists():
+            continue
+        rel = f.relative_to(root)
+        code = strip_lean(f.read_text(encoding="utf-8"))
+        for lineno, line in enumerate(code.splitlines(), 1):
+            for m in FORBIDDEN.finditer(line):
+                problems.append(f"{rel}:{lineno}: forbidden `{m.group(1)}`")
+            if rel != ALLOWED_AXIOM_FILE and AXIOM_DECL.search(line):
+                problems.append(f"{rel}:{lineno}: `axiom` outside {ALLOWED_AXIOM_FILE}")
+    return problems
+
+
+def main(argv: list[str]) -> int:
+    root = Path(argv[1]) if len(argv) > 1 else Path(__file__).resolve().parent.parent
+    problems = scan(root)
+    for p in problems:
+        print(f"::error::{p}")
+    if problems:
+        return 1
+    print("lean token scan OK")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
