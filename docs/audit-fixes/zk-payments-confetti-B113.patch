+import Zkpc
+
+/-!
+# Axiom-dependency gate (CI)
+
+Run from the repository root after `lake build`:
+
+```
+lake env lean scripts/check-axioms.lean
+```
+
+For **every** declaration whose defining module is `Zkpc` or `Zkpc.*`, this
+walks the declaration's type and value (and, for inductives, constructors)
+transitively through the whole environment, collects the kernel axioms it
+reaches, and fails (an elaboration error, hence a nonzero exit) if any reached
+axiom is outside the allowlist `propext`, `Classical.choice`, `Quot.sound`.
+The proof-hole axiom `sorryAx` is outside the allowlist, so a hole is caught
+here even if it is spelled in a way the token scan misses.
+
+This is the executable form of the claim in `README.md`/`OPEN-PROOFS.md` that
+every result depends only on Lean's three standard axioms. It checks actual
+kernel dependencies, not source tokens, so comments and strings cannot trigger
+it and a custom axiom declared in `Zkpc/Assumptions.lean` cannot slip through
+by being used. It cannot detect definition drift in the model.
+-/
+
+open Lean Elab Command
+
+namespace Zkpc.AxiomGate
+
+/-- Lean's three standard axioms: the only ones a Zkpc declaration may reach. -/
+def allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
+
+/-- Depth-first traversal with one visited set shared across all roots; returns
+the axioms newly reached from `n`. -/
+partial def visit (env : Environment) (n : Name) : StateM NameSet (Array Name) := do
+  if (← get).contains n then return #[]
+  modify (·.insert n)
+  match env.find? n with
+  | none => return #[]
+  | some ci =>
+    let mut acc : Array Name := if ci matches .axiomInfo _ then #[n] else #[]
+    for m in ci.type.getUsedConstants do
+      acc := acc ++ (← visit env m)
+    if let some v := ci.value? (allowOpaque := true) then
+      for m in v.getUsedConstants do
+        acc := acc ++ (← visit env m)
+    if let .inductInfo ii := ci then
+      for c in ii.ctors do
+        acc := acc ++ (← visit env c)
+    return acc
+
+/-- `#check_zkpc_axioms` fails if any `Zkpc.*`-module declaration reaches a
+kernel axiom outside `allowed`, naming the first declaration that reached it. -/
+elab "#check_zkpc_axioms" : command => do
+  let env ← getEnv
+  let mut roots : Array Name := #[]
+  for (n, _) in env.constants.map₁.toList do
+    let some idx := env.getModuleIdxFor? n | continue
+    let some mod := env.header.moduleNames[idx.toNat]? | continue
+    if (`Zkpc).isPrefixOf mod then roots := roots.push n
+  if roots.isEmpty then
+    throwError "no declarations found in Zkpc.* modules; is `import Zkpc` broken?"
+  let sorted := roots.qsort Name.lt
+  let mut seen : NameSet := {}
+  let mut reached : Array (Name × Name) := #[]
+  for r in sorted do
+    let (axs, seen') := (visit env r).run seen
+    seen := seen'
+    for a in axs do reached := reached.push (a, r)
+  let bad := reached.filter fun (a, _) => a ∉ allowed
+  let summary := reached.map (·.1)
+  if bad.isEmpty then
+    logInfo m!"axiom gate OK: {roots.size} Zkpc declarations reach only {summary}"
+  else
+    throwError m!"axiom gate FAILED: non-standard axioms reached (axiom, first \
+      declaration reaching it): {bad}"
+
+end Zkpc.AxiomGate
+
+#check_zkpc_axioms
