import Research.ProximityPrize.Frontier._IsoSparsityMasonStothers
import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots

/-!
# Five isolated roots without a complete dyadic subcoset

This formalizes the five-root construction in `probe_antipodal_subgroup_obstructions.py`.
For a primitive 32nd root `t`, the degree-two polynomials below have residual
`A(U)^2 - U O(U)^2 = -product_{i<5}(U-t^(2*i))`. Its complete root set has five
elements in `mu_16`, hence in the production halved subgroup `mu_(2^29)`. The odd
part is nonzero at every root. No root has its antipode in the root set, which
excludes every complete coset generated by a primitive root of nontrivial 2-power order.

Thus subgroup membership and exclusion of full dyadic subcosets do not repair
`IsolatedNonCosetCountResidual` at `k = 3`. This does not realize the original
high-head/low-tail decoded family and does not decide the production threshold.
-/

set_option autoImplicit false

namespace ProximityGap.Frontier.DyadicNonCosetCountCertificate

open Polynomial Finset IsoSparsityMasonStothers

variable {F : Type*} [Field F]

/-- The even part of the negative vanishing polynomial on the five lifts. -/
noncomputable def evenPoly (t : F) : F[X] :=
  C (t ^ 10) +
    C (t ^ 3 + t ^ 4 + 2 * t ^ 5 + 2 * t ^ 6 + 2 * t ^ 7 + t ^ 8 + t ^ 9) * X +
    C (1 + t + t ^ 2 + t ^ 3 + t ^ 4) * X ^ 2

/-- The odd part, with the sign convention `A(X^2) - X O(X^2)`. -/
noncomputable def oddPoly (t : F) : F[X] :=
  C (t ^ 6 + t ^ 7 + t ^ 8 + t ^ 9 + t ^ 10) +
    C (t + t ^ 2 + 2 * t ^ 3 + 2 * t ^ 4 + 2 * t ^ 5 + t ^ 6 + t ^ 7) * X + X ^ 2

/-- The five squared lifts, which will be the complete residual root set. -/
noncomputable def rootSet (t : F) : Finset F := by
  classical
  exact (range 5).image (fun i => t ^ (2 * i))

theorem evenPoly_degree_lt (t : F) : (evenPoly t).natDegree < 3 := by
  have h : (evenPoly t).natDegree ≤ 2 := by unfold evenPoly; compute_degree
  omega

theorem oddPoly_degree_lt (t : F) : (oddPoly t).natDegree < 3 := by
  have h : (oddPoly t).natDegree ≤ 2 := by unfold oddPoly; compute_degree
  omega

/-- The five lifts have exactly the specified even/odd decomposition. -/
theorem split_identity (t : F) (x : F) :
    (evenPoly t).eval (x ^ 2) - x * (oddPoly t).eval (x ^ 2) =
      -(∏ i ∈ range 5, (x - t ^ i)) := by
  norm_num [evenPoly, oddPoly, Finset.prod_range_succ]
  ring

/-- Complete factorization, so the construction has no unlisted roots. -/
theorem residual_factorization (t : F) :
    isoPoly (evenPoly t) (oddPoly t) =
      -(∏ i ∈ range 5, (X - C (t ^ (2 * i)))) := by
  norm_num [isoPoly, evenPoly, oddPoly, Finset.prod_range_succ]
  ring

/-- The factorization identifies the complete root set over the ambient field. -/
theorem isRoot_iff_mem (t u : F) :
    (isoPoly (evenPoly t) (oddPoly t)).IsRoot u ↔ u ∈ rootSet t := by
  classical
  rw [residual_factorization]
  simp [IsRoot, eval_prod, Finset.prod_eq_zero_iff, rootSet, eq_comm]

private theorem pow_half (t : F) (ht : IsPrimitiveRoot t 32) : t ^ 16 = -1 :=
  (IsPrimitiveRoot.pow (by norm_num : 0 < 32) ht
    (by norm_num : 32 = 16 * 2)).eq_neg_one_of_two_right

private theorem pow_ne_neg_pow (t : F) (ht : IsPrimitiveRoot t 32)
    {i j : ℕ} (hi : i < 16) (hj : j < 16) : t ^ i ≠ -(t ^ j) := by
  intro h
  have hpow : t ^ i = t ^ (j + 16) := by
    rw [pow_add, pow_half t ht, mul_neg_one]
    exact h
  have := ht.pow_inj (by omega) (by omega) hpow
  omega

/-- The five squared lifts are distinct. -/
theorem rootSet_card (t : F) (ht : IsPrimitiveRoot t 32) : (rootSet t).card = 5 := by
  classical
  rw [rootSet, card_image_of_injOn, card_range]
  intro i hi j hj hij
  have := ht.pow_inj (by have := mem_range.mp hi; omega)
    (by have := mem_range.mp hj; omega) hij
  omega

/-- Every root lies in the order-sixteen subgroup. -/
theorem root_pow_sixteen (t : F) (ht : IsPrimitiveRoot t 32) {u : F}
    (hu : u ∈ rootSet t) : u ^ 16 = 1 := by
  classical
  obtain ⟨i, hi, rfl⟩ := mem_image.mp hu
  rw [← pow_mul, show 2 * i * 16 = 32 * i by omega, pow_mul, ht.pow_eq_one, one_pow]

/-- These roots also lie in the literal production halved subgroup. -/
theorem root_pow_production_half (t : F) (ht : IsPrimitiveRoot t 32) {u : F}
    (hu : u ∈ rootSet t) : u ^ (2 ^ 29) = 1 := by
  rw [show (2 ^ 29 : ℕ) = 16 * 2 ^ 25 by norm_num, pow_mul,
    root_pow_sixteen t ht hu, one_pow]

/-- No squared lift has its antipode in the complete root set. -/
theorem neg_not_mem (t : F) (ht : IsPrimitiveRoot t 32) {u : F}
    (hu : u ∈ rootSet t) : -u ∉ rootSet t := by
  classical
  obtain ⟨i, hi, rfl⟩ := mem_image.mp hu
  rintro hneg
  obtain ⟨j, hj, hji⟩ := mem_image.mp hneg
  exact pow_ne_neg_pow t ht (by have := mem_range.mp hj; omega)
    (by have := mem_range.mp hi; omega) hji

/-- Each root remains isolated: its odd-part value is nonzero. -/
theorem oddPoly_eval_ne_zero (t : F) (ht : IsPrimitiveRoot t 32) {u : F}
    (hu : u ∈ rootSet t) : (oddPoly t).eval u ≠ 0 := by
  classical
  obtain ⟨i, hi, rfl⟩ := mem_image.mp hu
  have hi5 := mem_range.mp hi
  have hroot : ∏ j ∈ range 5, (t ^ i - t ^ j) = 0 :=
    Finset.prod_eq_zero hi (by simp)
  have hsquare : (t ^ i) ^ 2 = t ^ (2 * i) := by
    rw [← pow_mul, Nat.mul_comm i 2]
  have hsplit := split_identity t (t ^ i)
  rw [hroot, neg_zero, hsquare] at hsplit
  intro hO
  have hE : (evenPoly t).eval (t ^ (2 * i)) = 0 := by
    simpa [hO] using hsplit
  have hneg := split_identity t (-(t ^ i))
  rw [neg_sq, hsquare, hE, hO] at hneg
  have hprod : ∏ j ∈ range 5, (-(t ^ i) - t ^ j) = 0 := by simpa using hneg.symm
  obtain ⟨j, hj, hij⟩ := Finset.prod_eq_zero_iff.mp hprod
  have heq : t ^ j = -(t ^ i) := (sub_eq_zero.mp hij).symm
  exact pow_ne_neg_pow t ht (by have := mem_range.mp hj; omega) (by omega) heq

/-- Adding subgroup membership and excluding full dyadic subcosets cannot fix the cap. -/
theorem not_isolatedNonCosetCountResidual (t : F) (ht : IsPrimitiveRoot t 32) :
    ¬ IsolatedNonCosetCountResidual F 3 := by
  intro h
  have hcap := h (evenPoly t) (oddPoly t) (evenPoly_degree_lt t)
    (oddPoly_degree_lt t) (rootSet t) (fun u hu =>
      ⟨(isRoot_iff_mem t u).mpr hu, oddPoly_eval_ne_zero t ht hu⟩)
  rw [rootSet_card t ht] at hcap
  omega

/-- No complete coset of a nontrivial dyadic root group lies in the residual roots. -/
theorem no_complete_dyadic_coset (t : F) (ht : IsPrimitiveRoot t 32) (r : ℕ)
    (η v : F) (hη : IsPrimitiveRoot η (2 ^ (r + 1))) :
    ¬ ∀ j < 2 ^ (r + 1), (isoPoly (evenPoly t) (oddPoly t)).IsRoot (v * η ^ j) := by
  intro h
  have hhalf : η ^ (2 ^ r) = -1 :=
    (IsPrimitiveRoot.pow (by positivity) hη (by rw [pow_succ])).eq_neg_one_of_two_right
  have hv := h 0 (by positivity)
  have hneg := h (2 ^ r) (by rw [pow_succ]; have := pow_pos (by norm_num : 0 < 2) r; omega)
  simp only [pow_zero, mul_one] at hv
  rw [hhalf, mul_neg_one] at hneg
  exact neg_not_mem t ht ((isRoot_iff_mem t v).mp hv) ((isRoot_iff_mem t (-v)).mp hneg)

/-- A production-order generator supplies the five-root certificate in its halved subgroup. -/
theorem production_generator_certificate (g : F) (hg : IsPrimitiveRoot g (2 ^ 30)) :
    let t := g ^ (2 ^ 25)
    (rootSet t).card = 5 ∧
      (∀ u ∈ rootSet t, (isoPoly (evenPoly t) (oddPoly t)).IsRoot u ∧
        (oddPoly t).eval u ≠ 0 ∧ u ^ (2 ^ 29) = 1) ∧
      ¬ IsolatedNonCosetCountResidual F 3 := by
  dsimp only
  have ht : IsPrimitiveRoot (g ^ (2 ^ 25)) 32 :=
    IsPrimitiveRoot.pow (by norm_num : 0 < 2 ^ 30) hg
      (by norm_num : 2 ^ 30 = 2 ^ 25 * 32)
  exact ⟨rootSet_card _ ht, (fun u hu => ⟨(isRoot_iff_mem _ u).mpr hu,
    oddPoly_eval_ne_zero _ ht hu, root_pow_production_half _ ht hu⟩),
    not_isolatedNonCosetCountResidual _ ht⟩

end ProximityGap.Frontier.DyadicNonCosetCountCertificate

#print axioms ProximityGap.Frontier.DyadicNonCosetCountCertificate.residual_factorization
#print axioms ProximityGap.Frontier.DyadicNonCosetCountCertificate.oddPoly_eval_ne_zero
#print axioms ProximityGap.Frontier.DyadicNonCosetCountCertificate.no_complete_dyadic_coset
#print axioms ProximityGap.Frontier.DyadicNonCosetCountCertificate.not_isolatedNonCosetCountResidual
#print axioms ProximityGap.Frontier.DyadicNonCosetCountCertificate.production_generator_certificate
