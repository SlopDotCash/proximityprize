theorem ord_9347_156353 : ((9347 : ZMod 156353) ^ 16) = -1 := by decide

theorem not_injOn_spectrumVal_156353_h16 :
    ¬ Set.InjOn (spectrumVal (9347 : ZMod 156353))
        (spectrumData 16 ({1, 3} : Finset ℕ)) :=
  not_injOn_of_two_eq_sum _ 16 1 14 (by norm_num) (by norm_num) (by norm_num) engine_156353

