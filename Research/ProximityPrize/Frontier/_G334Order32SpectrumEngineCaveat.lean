import ArkLib.Data.CodingTheory.ProximityGap.TwoPowerSubsetSumSpectrum

/-!
# G334: n = 32 weight-`{1,3}` spectrum caveats beyond `p = 65537`

G331 (PR #292) recorded that at `h = 16` (`n = 32`), `p = 65537`, the KKH26 signed-sum
map is not injective (3264 values against the law 4512), via the small-integer generator
`g = -8`.  G332 / G333 (PR #319) then showed the Fermat / `g = 2` family is ring-uniform
and that the n = 64 rung fails at `65537` as well.

This file answers the natural follow-up: **which other primes make the n = 32 rung fail,
and by what mechanism?**  The answer is a reusable collision engine, not a Fermat-only
story.

## The engine

Every weight-1 vs weight-3 collision observed at this rung is one `g`-orbit generated by a
short relation in which the integer `2` is a signed combination of at most two roots:

  `2 · g^0 = g^a + g^b`    with `0 < a < b < h`.

Hypothesis discharge is one `decide`d arithmetic statement per prime; the non-injectivity
conclusion is then free.  In particular the engine fires at **non-Fermat** primes where no
small-integer root of unity exists, so G331's `g = -8` mechanism is sufficient but not
necessary.

## Instances at n = 32 (`h = 16`, `|data| = 4512`)

| p       | distinct | deficiency | generator | witness            |
|---------|----------|------------|-----------|--------------------|
| 194977  | 3616     | 896        | 180906    | `g^8  + g^13 = 2`  |
| 156353  | 3584     | 928        | 9347      | `g^1  + g^14 = 2`  |
| 50177   | 3584     | 928        | 7713      | `g^1  + g^12 = 2`  |
| 37217   | 3584     | 928        | 32508     | `g^4  + g^15 = 2`  |

(Companion probe: `scripts/probes/probe_order32_engine_caveats.py`.  At each of these primes
`p > 4512`, so the deficiency is genuine, not saturation.  For contrast the same probe
records injectivity at `16033`, `786433`, and `6700417`.)

Named prize claim advanced: `ArkLib.ProximityGap.KKH26.subsetSumSpectrum_card`
(`ArkLib/Data/CodingTheory/ProximityGap/TwoPowerSubsetSumSpectrum.lean`).  Its hypothesis
`hinj` is unavailable at each of the four primes above.

Honest scope:
* Closes off four more field choices for future n = 32 spectrum / MCA pins, and packages
  the general `2 = g^a + g^b` form so further instances are one-line.
* Does **not** contradict any in-tree theorem: `sVal_injOn` requires `p > 2^80`;
  `subsetSumSpectrum_card` stays true (conditional on `hinj`).
* Not a δ\* pin, not a field-uniform census theorem, no production claim.
* Does not restate G331's `65537` instance (different mechanism, already open as #292).
* Open PR #272 prints per-prime census side data via a monomial-pencil route; what is new
  here is the injectivity reading, the Lean engine, and the four certificates.
-/

open Finset

namespace ArkLib.ProximityGap.Frontier.G334Order32SpectrumEngineCaveat

open ArkLib.ProximityGap.KKH26

set_option maxRecDepth 100000

/-! ### Reusable engine: `2 · g^0` as a sum of two roots -/

/-- Weight-`1` datum with positive part `{0}`: value `+g^0`. -/
def dOnePos : (_ : ℕ) × ((_ : Finset ℕ) × Finset ℕ) := ⟨1, ⟨{0}, {0}⟩⟩

/-- Weight-`3` datum at support `{0,a,b}` with positive part `{a,b}`. -/
def dTwo (a b : ℕ) : (_ : ℕ) × ((_ : Finset ℕ) × Finset ℕ) := ⟨3, ⟨{0, a, b}, {a, b}⟩⟩

theorem sVal_dOnePos {F : Type*} [CommRing F] (g : F) : sVal g dOnePos.2 = g ^ 0 := by
  simp [dOnePos, sVal]

theorem dOnePos_mem {h : ℕ} (hh : 1 ≤ h) : dOnePos ∈ spectrumData h ({1, 3} : Finset ℕ) := by
  simp only [spectrumData, Finset.mem_sigma, mem_sigData, dOnePos]
  refine ⟨by decide, ⟨?_, by decide⟩, by decide⟩
  intro i hi
  simp only [Finset.mem_singleton, Finset.mem_range] at hi ⊢
  omega

theorem dTwo_mem {h a b : ℕ} (ha : 0 < a) (hab : a < b) (hb : b < h) :
    dTwo a b ∈ spectrumData h ({1, 3} : Finset ℕ) := by
  have h0a : (0 : ℕ) ≠ a := by omega
  have h0b : (0 : ℕ) ≠ b := by omega
  simp only [spectrumData, Finset.mem_sigma, mem_sigData, dTwo]
  refine ⟨by decide, ⟨?_, ?_⟩, ?_⟩
  · intro i hi
    simp only [Finset.mem_insert, Finset.mem_singleton, Finset.mem_range] at hi ⊢
    omega
  · simp [h0a, h0b, hab.ne]
  · intro i hi
    simp only [Finset.mem_insert, Finset.mem_singleton] at hi ⊢
    omega

theorem dTwo_sVal {F : Type*} [CommRing F] (g : F) (a b : ℕ) (ha : 0 < a) (hab : a < b) :
    sVal g (dTwo a b).2 = g ^ a + g ^ b - g ^ 0 := by
  have h0a : (0 : ℕ) ≠ a := by omega
  have h0b : (0 : ℕ) ≠ b := by omega
  simp [dTwo, sVal, h0a, h0b, hab.ne]

/-- **Collision engine.**  If `2 · g^0 = g^a + g^b` with `0 < a < b < h`, then the weight-`1`
datum `({0},{0})` and the weight-`3` datum `({0,a,b},{a,b})` have the same value `g^0`, so the
KKH26 signed-sum map is not injective at `g`. -/
theorem not_injOn_of_two_eq_sum {F : Type*} [CommRing F] (g : F) (h a b : ℕ)
    (ha : 0 < a) (hab : a < b) (hb : b < h) (hsum : g ^ a + g ^ b = 2 * g ^ 0) :
    ¬ Set.InjOn (spectrumVal g) (spectrumData h ({1, 3} : Finset ℕ)) := by
  intro hinj
  have h1 : dOnePos ∈ spectrumData h ({1, 3} : Finset ℕ) := dOnePos_mem (by omega)
  have h2 : dTwo a b ∈ spectrumData h ({1, 3} : Finset ℕ) := dTwo_mem ha hab hb
  have hv : spectrumVal g dOnePos = spectrumVal g (dTwo a b) := by
    simp only [spectrumVal, sVal_dOnePos, dTwo_sVal g a b ha hab]
    rw [hsum]; ring
  have : dOnePos = dTwo a b := hinj h1 h2 hv
  simp [dOnePos, dTwo] at this

/-! ### Instance: `p = 194977` (largest z-score deficiency below 200000) -/

theorem engine_194977 :
    (180906 : ZMod 194977) ^ 8 + (180906 : ZMod 194977) ^ 13
      = 2 * (180906 : ZMod 194977) ^ 0 := by
  decide

theorem ord_180906_194977 : ((180906 : ZMod 194977) ^ 16) = -1 := by decide

theorem not_injOn_spectrumVal_194977_h16 :
    ¬ Set.InjOn (spectrumVal (180906 : ZMod 194977))
        (spectrumData 16 ({1, 3} : Finset ℕ)) :=
  not_injOn_of_two_eq_sum _ 16 8 13 (by norm_num) (by norm_num) (by norm_num) engine_194977

/-! ### Instance: `p = 156353` -/

theorem engine_156353 :
    (9347 : ZMod 156353) ^ 1 + (9347 : ZMod 156353) ^ 14
