import ArkLib.AGM.Basic
import ProximityPrize.Compatibility.AGM
import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Data.List.OfFn

/-!
# Canonical finite-basis representation facts and the exact-length list bridge

The representation type is supplied by ArkLib.AGM.Basic. Broader historical list/truncation
results and the completed handle interpreter live in ProximityPrize.Compatibility.AGM.
-/

open scoped BigOperators

namespace AGM.GroupRepresentation

variable {G : Type*} [Group G] {p : ℕ} [Fact (Nat.Prime p)] [PrimeOrderWith G p]
  {ι : Type*} [Fintype ι] {basis : ι → G} {target : G}

/-- A represented target belongs to the subgroup generated by its finite basis. -/
theorem target_mem_closure (repr : GroupRepresentation basis target) :
    target ∈ Subgroup.closure (Set.range basis) := by
  rw [← repr.hEq]
  refine (Subgroup.closure (Set.range basis)).prod_mem ?_
  intro i _
  exact (Subgroup.closure (Set.range basis)).pow_mem
    (Subgroup.subset_closure ⟨i, rfl⟩) _

/-- Membership of all basis elements in a subgroup implies membership of the target. -/
theorem target_mem_of_forall_mem (repr : GroupRepresentation basis target)
    (H : Subgroup G) (hbasis : ∀ i, basis i ∈ H) : target ∈ H := by
  exact ((Subgroup.closure_le H).2 (by rintro _ ⟨i, rfl⟩; exact hbasis i))
    repr.target_mem_closure

/-- The basis and coefficient function determine the target. -/
theorem target_eq_of_exponents_eq {t₁ t₂ : G}
    (r₁ : GroupRepresentation basis t₁) (r₂ : GroupRepresentation basis t₂)
    (h : r₁.exponents = r₂.exponents) : t₁ = t₂ := by
  rw [← r₁.hEq, ← r₂.hEq, h]

/-- Zero coefficients represent the identity over every finite basis. -/
def one (basis : ι → G) : GroupRepresentation basis 1 where
  exponents := fun _ => 0
  hEq := by simp

/-- A one-element basis represents every modular power of that element. -/
def singleton (g : G) (a : ZMod p) :
    GroupRepresentation (fun _ : Fin 1 => g) (g ^ a.val) where
  exponents := fun _ => a
  hEq := by simp

/-- A homomorphism transports a finite-basis representation without changing coefficients. -/
def map {H : Type*} [Group H] [PrimeOrderWith H p] (f : G →* H)
    (repr : GroupRepresentation basis target) :
    GroupRepresentation (f ∘ basis) (f target) where
  exponents := repr.exponents
  hEq := by simpa only [map_prod, map_pow, Function.comp_apply] using congrArg f repr.hEq

/-- Same-basis representations multiply by adding their modular coefficients. -/
def mul {t₁ t₂ : G} (r₁ : GroupRepresentation basis t₁)
    (r₂ : GroupRepresentation basis t₂) : GroupRepresentation basis (t₁ * t₂) where
  exponents := fun i => r₁.exponents i + r₂.exponents i
  hEq := by
    simp_rw [pow_val_add]
    rw [Finset.prod_mul_distrib, r₁.hEq, r₂.hEq]

/-- Inverting the basis represents the inverse target with the same coefficients. -/
def inv (repr : GroupRepresentation basis target) :
    GroupRepresentation (fun i => (basis i)⁻¹) target⁻¹ where
  exponents := repr.exponents
  hEq := by
    calc
      (∏ i, (basis i)⁻¹ ^ (repr.exponents i).val) =
          (∏ i, basis i ^ (repr.exponents i).val)⁻¹ := by simp [inv_pow]
      _ = target⁻¹ := congrArg Inv.inv repr.hEq

end AGM.GroupRepresentation

namespace ProximityPrize.Compatibility.AGM

/-- Zipping equal-length enumerated functions is pointwise enumeration. -/
theorem zipWith_ofFn {α β γ : Type*} {n : ℕ} (f : Fin n → α) (g : Fin n → β)
    (op : α → β → γ) :
    (List.ofFn f).zipWith op (List.ofFn g) = List.ofFn (fun i => op (f i) (g i)) := by
  apply List.ext_getElem (by simp)
  intro i hi hj
  simp

namespace ListRepresentation

variable {G : Type*} [Group G] {p : ℕ} [Fact (Nat.Prime p)] [PrimeOrderWith G p]

/-- A historical list certificate with exactly one coefficient per basis element gives the
canonical representation over the finite list indices. No truncation is hidden by this bridge. -/
def toCanonical {prev : List G} {target : G} (repr : ListRepresentation (p := p) prev target)
    (hlen : repr.exponents.length = prev.length) :
    _root_.AGM.GroupRepresentation (fun i : Fin prev.length => prev.get i) target where
  exponents := fun i => repr.exponents.get (Fin.cast hlen.symm i)
  hEq := by
    have hp : List.ofFn (fun i : Fin prev.length => prev.get i) = prev := List.ofFn_get prev
    have he : List.ofFn (fun i : Fin prev.length =>
        repr.exponents.get (Fin.cast hlen.symm i)) = repr.exponents := by
      apply List.ext_getElem (by simp [hlen])
      intro i hi hj
      simp
    have hzip : ((List.ofFn (fun i : Fin prev.length => prev.get i)).zipWith
        (fun g a => g ^ a.val)
        (List.ofFn (fun i : Fin prev.length =>
          repr.exponents.get (Fin.cast hlen.symm i)))).prod =
        (prev.zipWith (fun g a => g ^ a.val) repr.exponents).prod :=
      congrArg₂ (fun (xs : List G) (es : List (ZMod p)) =>
        (xs.zipWith (fun g a => g ^ a.val) es).prod) hp he
    rw [zipWith_ofFn, List.prod_ofFn] at hzip
    exact hzip.trans repr.hEq

/-- Every finite-index canonical certificate has an equal-length list presentation. -/
def ofCanonical {n : ℕ} {basis : Fin n → G} {target : G}
    (repr : _root_.AGM.GroupRepresentation basis target) :
    ListRepresentation (p := p) (List.ofFn basis) target where
  exponents := List.ofFn repr.exponents
  hEq := by
    rw [zipWith_ofFn]
    simpa only [List.prod_ofFn] using repr.hEq

/-- The list presentation of a canonical certificate has exactly the basis length. -/
theorem ofCanonical_length {n : ℕ} {basis : Fin n → G} {target : G}
    (repr : _root_.AGM.GroupRepresentation basis target) :
    (ofCanonical repr).exponents.length = (List.ofFn basis).length := by simp [ofCanonical]

end ListRepresentation
end ProximityPrize.Compatibility.AGM

