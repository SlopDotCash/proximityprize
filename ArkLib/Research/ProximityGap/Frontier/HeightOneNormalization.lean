/-! # Reassembling a normalization from the primes of a factorial base

First clear denominators of minimal-polynomial coefficients in a UFD. Above each
principal prime, apply the height-one intersection theorem to its Dedekind normalization.
-/

namespace ArkLib.ProximityGap.HeightOneNormalization

open Polynomial IsDedekindDomain

variable {A K E : Type*} [CommRing A] [IsDomain A] [Field K] [Algebra A K]
  [IsFractionRing A K]

/-- The generic point of the prime divisor cut out by a prime element. -/
def divisor {p : A} (hp : Prime p) : PrimeSpectrum A :=
  ⟨Ideal.span {p}, Ideal.isPrime_span_singleton_of_prime hp⟩

/-- The subring of the actual function field regular at a prime divisor. -/
noncomputable abbrev localBase (K : Type*) [Field K] [Algebra A K] [IsFractionRing A K]
    {p : A} (hp : Prime p) : Subalgebra A K :=
  Localization.subalgebra.ofField K (divisor hp).asIdeal.primeCompl
    (divisor hp).asIdeal.primeCompl_le_nonZeroDivisors

variable [UniqueFactorizationMonoid A]

/-- In a UFD every nonintegral fraction has a pole at a prime element. -/
theorem integer_of_regular (x : K) (h : ∀ (p : A) (hp : Prime p), x ∈ localBase K hp) :
    IsLocalization.IsInteger A x := by
  apply IsFractionRing.isInteger_of_isUnit_den
  by_contra hden
  obtain ⟨p, hpi, hpd⟩ := WfDvdMonoid.exists_irreducible_factor hden
    (nonZeroDivisors.ne_zero (IsFractionRing.den A x).property)
  have hp : Prime p := hpi.prime
  obtain ⟨a, s, hs, hx⟩ := h p hp
  have hps : ¬p ∣ s := fun hps ↦ hs (Ideal.mem_span_singleton.mpr hps)
  have hs0 : s ≠ 0 := fun hz ↦ hps (hz ▸ dvd_zero p)
  have hsK : algebraMap A K s ≠ 0 := by simpa using (IsFractionRing.injective A K).ne hs0
  have hd := (IsFractionRing.num_mul_den_eq_num_iff_eq (A := A) (x := x) (y := x)).mpr rfl
  have heq : IsFractionRing.num A x * s = a * (IsFractionRing.den A x : A) := by
    apply IsFractionRing.injective A K
    rw [map_mul, map_mul, ← hd, hx]
    field_simp
  have hpn : p ∣ IsFractionRing.num A x :=
    (hp.dvd_or_dvd (heq ▸ dvd_mul_of_dvd_right hpd a)).resolve_right hps
  exact hp.not_isUnit ((IsFractionRing.num_den_reduced A x) hpn hpd)

variable [Field E] [Algebra K E] [Algebra A E] [IsScalarTower A K E]

/-- Integral dependence in an algebraic function field is detected by the local bases
at all prime divisors. The argument glues the coefficients of one minimal polynomial. -/
theorem integral_of_integral_at_divisors (x : E) (halg : IsIntegral K x)
    (h : ∀ (p : A) (hp : Prime p), IsIntegral (localBase K hp) x) : IsIntegral A x := by
  have hl : minpoly K x ∈ Polynomial.lifts (algebraMap A K) := by
    apply (Polynomial.lifts_iff_coeff_lifts _).mpr
    intro n
    apply integer_of_regular
    intro p hp
    let : IsIntegrallyClosed (localBase K hp) := isIntegrallyClosed_of_isLocalization _
      (divisor hp).asIdeal.primeCompl (divisor hp).asIdeal.primeCompl_le_nonZeroDivisors
    rw [minpoly.isIntegrallyClosed_eq_field_fractions' K (h p hp), coeff_map]
    exact Subtype.property _
  obtain ⟨g, hg, _, hgm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hl (minpoly.monic halg)
  refine ⟨g, hgm, ?_⟩
  change aeval x g = 0
  rw [← Polynomial.aeval_map_algebraMap K, hg, minpoly.aeval]

variable [IsNoetherianRing A]

omit [UniqueFactorizationMonoid A] in
/-- At a prime element of a Noetherian factorial domain the maximal ideal of the
localization is generated by its image, so this local ring is a DVR. -/
theorem localBase_dvr {p : A} (hp : Prime p) : IsDiscreteValuationRing (localBase K hp) := by
  let P := (divisor hp).asIdeal
  let B := localBase K hp
  let : P.IsPrime := (divisor hp).isPrime
  let : IsNoetherianRing B := IsLocalization.isNoetherianRing P.primeCompl B inferInstance
  let : IsLocalRing B := IsLocalization.AtPrime.isLocalRing B P
  have hP : P ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr hp.ne_zero
  have hnf := IsLocalization.AtPrime.not_isField A hP B
  apply ((IsDiscreteValuationRing.TFAE B hnf).out 5 1).mp
  refine ⟨algebraMap A B p, ?_⟩
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal P B]
  simp only [P, divisor, Ideal.map_span, Set.image_singleton]

variable [FiniteDimensional K E] [Algebra.IsSeparable K E]

/-- The normalization of the base DVR in the given finite separable extension. -/
noncomputable abbrev localNormalization (E : Type*) [Field E] [Algebra K E] {p : A}
    (hp : Prime p) := integralClosure (localBase K hp) E

omit [Algebra A E] [IsScalarTower A K E] [UniqueFactorizationMonoid A] in
private theorem normalization_dedekind {p : A} (hp : Prime p) :
    IsDedekindDomain (localNormalization (K := K) E hp) := by
  let : IsDiscreteValuationRing (localBase K hp) := localBase_dvr hp
  exact integralClosure.isDedekindDomain (localBase K hp) K E

omit [UniqueFactorizationMonoid A] [Algebra A E] [IsScalarTower A K E] [IsNoetherianRing A]
  [Algebra.IsSeparable K E] in
private theorem normalization_fractionRing {p : A} (hp : Prime p) :
    IsFractionRing (localNormalization (K := K) E hp) E :=
  IsIntegralClosure.isFractionRing_of_finite_extension (localBase K hp) K E _

/-- The localization of the actual normalized ring at a nonzero prime over a base divisor. -/
noncomputable abbrev branchRing {p : A} (hp : Prime p)
    (w : HeightOneSpectrum (localNormalization (K := K) E hp)) :
    Subalgebra (localNormalization (K := K) E hp) E :=
  letI := normalization_fractionRing (K := K) (E := E) hp
  Localization.subalgebra.ofField E w.asIdeal.primeCompl w.asIdeal.primeCompl_le_nonZeroDivisors

omit [UniqueFactorizationMonoid A] [Algebra A E] [IsScalarTower A K E] in
/-- The integral closure over each base divisor is finite over the base DVR. -/
theorem localNormalization_finite {p : A} (hp : Prime p) :
    Module.Finite (localBase K hp) (localNormalization (K := K) E hp) := by
  let : IsDiscreteValuationRing (localBase K hp) := localBase_dvr hp
  exact IsIntegralClosure.finite (localBase K hp) K E _

omit [UniqueFactorizationMonoid A] [Algebra A E] [IsScalarTower A K E] in
/-- Every branch ring in the intersection is a DVR with the given extension as fraction field. -/
theorem branchRing_dvr {p : A} (hp : Prime p)
    (w : HeightOneSpectrum (localNormalization (K := K) E hp)) :
    IsDiscreteValuationRing (branchRing hp w) ∧ IsFractionRing (branchRing hp w) E := by
  let C := localNormalization (K := K) E hp
  let : IsDedekindDomain C := normalization_dedekind hp
  let : IsFractionRing C E := normalization_fractionRing hp
  exact ⟨IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain C w.ne_bot _,
    Localization.subalgebra.isFractionRing_ofField ..⟩

/-- Regularity in the upstairs branch rings implies integrality over the original base. -/
theorem integral_of_regular_at_branches (x : E)
    (h : ∀ (p : A) (hp : Prime p) (w : HeightOneSpectrum (localNormalization (K := K) E hp)),
      x ∈ branchRing hp w) : IsIntegral A x := by
  apply integral_of_integral_at_divisors (K := K) x (Algebra.IsIntegral.isIntegral x)
  intro p hp
  let C := localNormalization (K := K) E hp
  let : IsDedekindDomain C := normalization_dedekind hp
  let : IsFractionRing C E := normalization_fractionRing hp
  have hh : x ∈ (⊥ : Subalgebra C E) := by
    rw [← HeightOneSpectrum.iInf_localization_eq_bot C, Algebra.mem_iInf]
    exact h p hp
  obtain ⟨c, hc⟩ := Algebra.mem_bot.mp hh
  exact hc ▸ c.property

/-- A field derivation regular on every branch of the normalization over each prime divisor
preserves every element integral over the factorial base. -/
theorem derivation_preserves_normalization [Algebra ℤ E] (D : Derivation ℤ E E)
    (h : ∀ (p : A) (hp : Prime p) (w : HeightOneSpectrum (localNormalization (K := K) E hp)),
      ∀ b ∈ branchRing hp w, D b ∈ branchRing hp w) :
    ∀ x : E, IsIntegral A x → IsIntegral A (D x) := by
  intro x hx
  apply integral_of_regular_at_branches (K := K)
  intro p hp w
  apply h p hp w
  exact (branchRing hp w).algebraMap_mem ⟨x, show IsIntegral (localBase K hp) x from hx.tower_top⟩

noncomputable section Plane

attribute [local instance high] Algebra.toSMul

open NormalizedSectionSpecialization

variable {R L : Type*} [CommRing R] [IsDomain R] [Field L] [Algebra R L] [IsFractionRing R L]

private noncomputable abbrev polynomialFractionAlgebra (k : Type*) [Field k] :
    Algebra k[X] (FractionRing k[X]) := inferInstance

local instance planeFractionAlgebra : Algebra R[X] (FractionRing L[X]) :=
  (genericCoeffs (R := R) (L := L)).toAlgebra

omit [IsDomain R] in
private theorem planeFraction : IsFractionRing R[X] (FractionRing L[X]) := by
  let : Algebra R[X] L[X] := Polynomial.algebra R L
  let : Algebra L[X] (FractionRing L[X]) := polynomialFractionAlgebra L
  let : Algebra R[X] (FractionRing L[X]) := planeFractionAlgebra
  let : IsScalarTower R[X] L[X] (FractionRing L[X]) := IsScalarTower.of_algebraMap_eq' rfl
  let M := (nonZeroDivisors R).map (Polynomial.C : R →+* R[X])
  let : IsLocalization M L[X] := Polynomial.isLocalization _ _
  have hi : Function.Injective (algebraMap R[X] L[X]) :=
    Polynomial.map_injective _ (IsFractionRing.injective R L)
  have hm : (nonZeroDivisors L[X]).comap (algebraMap R[X] L[X]) = nonZeroDivisors R[X] :=
    le_antisymm (comap_nonZeroDivisors_le_of_injective hi)
      (nonZeroDivisors_le_comap_nonZeroDivisors_of_injective _ hi)
  rw [IsFractionRing, ← hm]
  exact IsLocalization.localization_localization_isLocalization_of_has_all_units
    M (nonZeroDivisors L[X]) _ fun _ h ↦ h.mem_nonZeroDivisors

attribute [local instance] planeFraction

local instance curveFinite (F : R[X][X]) [h : Fact (Irreducible
    (F.map (genericCoeffs (R := R) (L := L))))] :
    FiniteDimensional (FractionRing L[X]) (Curve (L := L) F) :=
  (AdjoinRoot.powerBasis h.out.ne_zero).finite

omit [IsDomain R] in
private theorem curveSeparable (F : R[X][X]) [h : Fact (Irreducible
    (F.map (genericCoeffs (R := R) (L := L))))] (z q : R)
    (h₁ : (F.derivative.map (evalRingHom z)).eval q ≠ 0) :
    Algebra.IsSeparable (FractionRing L[X]) (Curve (L := L) F) := by
  let i := genericCoeffs (R := R) (L := L)
  have hi : Function.Injective i := IsFractionRing.injective R[X] (FractionRing L[X])
  have hs : (F.map i).Separable := (Polynomial.separable_iff_derivative_ne_zero h.out).mpr (by
    intro hz
    rw [Polynomial.derivative_map, Polynomial.map_eq_zero_iff hi] at hz
    simp [hz] at h₁)
  have hy : AdjoinRoot.root (F.map i) ∈ separableClosure (FractionRing L[X]) (Curve (L := L) F) :=
    mem_separableClosure_iff.mpr (hs.of_dvd (minpoly.dvd _ _
      (by rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self])))
  constructor
  intro x
  obtain ⟨g, rfl⟩ := AdjoinRoot.mk_surjective (g := F.map i) x
  apply mem_separableClosure_iff.mp
  rw [← AdjoinRoot.aeval_eq]
  exact Algebra.adjoin_singleton_le (S := (separableClosure _ _).toSubalgebra) hy
    (g.aeval_mem_adjoin_singleton _ _)

/-- Branchwise regularity of a derivation in the function field of an actual plane equation. -/
def regularOnPlaneBranches (F : R[X][X]) [Fact (Irreducible
    (F.map (genericCoeffs (R := R) (L := L))))]
    (D : Derivation ℤ (Curve (L := L) F) (Curve (L := L) F)) : Prop :=
  ∀ (p : R[X]) (hp : Prime p) (w : HeightOneSpectrum
    (localNormalization (K := FractionRing L[X]) (Curve (L := L) F) hp)),
    ∀ b ∈ branchRing hp w, D b ∈ branchRing hp w

/-- Tangent divisibility on every simple section follows from regularity of the
field derivation in the actual localizations above the prime divisors of the plane. -/
theorem implicit_derivative_divides_of_regular_at_branches [UniqueFactorizationMonoid R]
    [IsNoetherianRing R] (F : R[X][X])
    [Fact (Irreducible (F.map (genericCoeffs (R := R) (L := L))))]
    (z q : R) (hl : F.leadingCoeff.eval z ≠ 0)
    (h₀ : (F.map (evalRingHom z)).eval q = 0)
    (h₁ : (F.derivative.map (evalRingHom z)).eval q ≠ 0)
    (D : Derivation ℤ (Curve (L := L) F) (Curve (L := L) F))
    (hD : regularOnPlaneBranches F D) (δ : Derivation ℤ R[X] R[X])
    (hδ : ∀ c, D (planeBase (L := L) F c) = planeBase F (δ c))
    (a : R[X]) (ha : AdjoinRoot.root _ ≠ planeBase (L := L) F a) :
    (F.derivative.map (evalRingHom z)).eval q ∣
      (F.eval a).eval z * ((coefficientDerivative δ F).map (evalRingHom z)).eval q := by
  let : Algebra R[X] (Curve (L := L) F) := (planeBase (L := L) F).toAlgebra
  let : IsScalarTower R[X] (FractionRing L[X]) (Curve (L := L) F) :=
    IsScalarTower.of_algebraMap_eq' rfl
  let : Algebra.IsSeparable (FractionRing L[X]) (Curve (L := L) F) := curveSeparable F z q h₁
  apply implicit_derivative_divides F z q hl h₀ h₁ D _ δ hδ a ha
  exact derivation_preserves_normalization (A := R[X]) (K := FractionRing L[X])
    (E := Curve (L := L) F) D hD

end Plane

end ArkLib.ProximityGap.HeightOneNormalization

