import ArkLib.Research.ProximityGap.Frontier.MovingCubicVanishingBranch
import ArkLib.Research.ProximityGap.Frontier.SecondPrimeComponentIncidence
import Mathlib.FieldTheory.AlgebraicClosure
import Mathlib.RingTheory.Polynomial.GaussLemma
import Mathlib.RingTheory.Polynomial.ScaleRoots

/-! # Specializing an algebraic polynomial section

A primitive component whose generic root is a polynomial with algebraic
coefficients has a single possible coefficient-field value at every scalar site.
A monic integral equation supplies a specialized annihilator without any assumption
that the constant extension is separable or generated by a single element.
-/

set_option autoImplicit false
noncomputable section

open Polynomial

namespace ArkLib.ProximityGap.Frontier.AlgebraicSectionSpecialization

open MovingCubicVanishingBranch

variable {k L : Type*} [Field k] [Field L] [Algebra k L]

private theorem scalar_root_of_minpoly {E : Type*} [Field E] [Algebra k E]
    (u : E) (hu : IsIntegral k u) (w : k) (hw : (minpoly k u).eval w = 0) :
    u = algebraMap k E w := by
  have hh : aeval (algebraMap k E w) (minpoly k u) = 0 := by
    rw [aeval_algebraMap_apply, coe_aeval_eq_eval, hw, map_zero]
  have he := minpoly.eq_of_irreducible_of_monic (minpoly.irreducible hu) hh (minpoly.monic hu)
  rw [minpoly.eq_X_sub_C] at he
  have hz := minpoly.aeval k u
  rw [he, map_sub, aeval_X, aeval_C, sub_eq_zero] at hz
  exact hz

private theorem integral_eval {E : Type*} [Field E] [Algebra k E] [Algebra E L]
    [IsScalarTower k E L] [Algebra k[X] L] [IsScalarTower k k[X] L]
    (hE : ∀ z : E, IsIntegral k (algebraMap E L z)) (s : E[X]) (x : L) (hx : IsIntegral k[X] x) :
    IsIntegral k[X] (s.eval₂ (algebraMap E L) x) := by
  induction s using Polynomial.induction_on' with
  | add p q hp hq => rw [eval₂_add]; exact hp.add hq
  | monomial n a =>
      rw [eval₂_monomial]
      exact (hE a).tower_top.mul (hx.pow n)

set_option maxHeartbeats 900000 in
/-- Constructing a specialized annihilator at a site suffices for site-value
descent. The hypothesis on divisibility records the kernel of generic evaluation. -/
theorem section_at_site [Algebra k[X] L] [IsScalarTower k k[X] L]
    (x y : L) (hx : algebraMap k[X] L Polynomial.X = x) (f : k[X][X])
    (hker : ∀ H : k[X][X], aeval y H = 0 → f ∣ H)
    (q : L[X]) (hq : q.eval x = y) (hcoeff : ∀ i, IsAlgebraic k (q.coeff i))
    (a w : k) (hsite : (f.map (evalRingHom a)).eval w = 0) :
    q.eval (algebraMap k L a) = algebraMap k L w := by
  let E := algebraicClosure k L
  have hQ : q ∈ lifts (algebraMap E L) := by
    apply (lifts_iff_coeff_lifts _).mpr
    intro i
    exact ⟨⟨q.coeff i, (hcoeff i).isIntegral⟩,rfl⟩
  obtain ⟨Q,hQmap⟩ := (mem_lifts _).mp hQ
  let aE := algebraMap k E a
  let u : E := Q.eval aE
  have hu : IsIntegral k u := (Algebra.IsAlgebraic.isAlgebraic u).isIntegral
  let m := minpoly k u
  let T := (m.map (algebraMap k E)).comp Q
  have hTa : T.eval aE = 0 := by
    rw [show T = _ from rfl, eval_comp, eval_map_algebraMap]
    exact minpoly.aeval k u
  obtain ⟨S,hS⟩ := (dvd_iff_isRoot.mpr hTa : Polynomial.X-C aE ∣ T)
  let r := S.eval₂ (algebraMap E L) x
  have hxInt : IsIntegral k[X] x := hx ▸ isIntegral_algebraMap
  have hE (z : E) : IsIntegral k (algebraMap E L z) := z.property
  obtain ⟨G,hG,hGr⟩ := integral_eval hE S x hxInt
  let shift : k[X] := Polynomial.X-C a
  let mb : k[X][X] := m.map C
  let H : k[X][X] := (G.scaleRoots shift).comp mb
  have hAl (q₀ : k[X]) : aeval x q₀ = algebraMap k[X] L q₀ := by
    have he : (aeval x).toRingHom = algebraMap k[X] L := by
      ext z
      · change (aeval x) (C z) = algebraMap k[X] L (C z)
        rw [aeval_C]
        exact IsScalarTower.algebraMap_apply k k[X] L z
      · exact (aeval_X x).trans hx.symm
    exact RingHom.congr_fun he q₀
  have heQ : Q.eval₂ (algebraMap E L) x = y := by
    rw [eval₂_eq_eval_map, hQmap]
    exact hq
  have hmr : aeval y mb = algebraMap k[X] L shift * r := by
    have hs := congrArg (fun U : E[X] => U.eval₂ (algebraMap E L) x) hS
    change T.eval₂ _ x = _ at hs
    rw [show T = _ from rfl, eval₂_comp, heQ, eval₂_map, eval₂_mul, eval₂_sub, eval₂_X,
      eval₂_C] at hs
    rw [show mb = _ from rfl, aeval_def, eval₂_map, ← hAl, show shift = _ from rfl, map_sub,
      aeval_X, aeval_C]
    have hC : (algebraMap k[X] L).comp C = algebraMap k L :=
      RingHom.ext fun z => (IsScalarTower.algebraMap_apply k k[X] L z).symm
    rw [hC]
    simpa only [← IsScalarTower.algebraMap_eq k E L, aE, ← IsScalarTower.algebraMap_apply k E L] using hs
  have hH : aeval y H = 0 := by
    rw [show H = _ from rfl, aeval_comp, hmr]
    exact scaleRoots_aeval_eq_zero hGr
  have hHw : (H.map (evalRingHom a)).eval w = 0 := by
    obtain ⟨b,hb⟩ := hker H hH
    rw [hb, Polynomial.map_mul, eval_mul, hsite, zero_mul]
  have hs0 : (evalRingHom a) shift = 0 := by simp [shift]
  have hGlead : (G.map (evalRingHom a)).Monic := hG.map _
  have hmb : mb.map (evalRingHom a) = m := by
    rw [show mb = _ from rfl, Polynomial.map_map]
    have he : (evalRingHom a).comp C = RingHom.id k := by ext z; simp
    rw [he, map_id]
  have hmw : m.eval w = 0 := by
    rw [show H = _ from rfl, map_comp, eval_comp, hmb,
      map_scaleRoots _ _ _ (by simp [hG.leadingCoeff]), hs0, scaleRoots_zero,
      hGlead.leadingCoeff, one_smul, eval_pow, eval_X] at hHw
    exact (pow_eq_zero_iff (by aesop)).mp hHw
  have he := scalar_root_of_minpoly u hu w hmw
  have huv : q.eval (algebraMap k L a) = algebraMap E L u := by
    rw [← hQmap, IsScalarTower.algebraMap_apply k E L, eval_map_apply]
  rw [huv, he, ← IsScalarTower.algebraMap_apply k E L]

/-- Gauss descent turns the kernel at the generic root into primitive
divisibility in the polynomial ring before specialization. -/
theorem generic_root_dvd {k : Type} [Field k] (f : k[X][X]) (hprim : f.IsPrimitive)
    (H : k[X][X]) (hH : aeval (AdjoinRoot.root (genericEquation f)) H = 0) : f ∣ H := by
  apply hprim.dvd_of_fraction_map_dvd_fraction_map (K := RatFunc k)
  apply AdjoinRoot.mk_eq_zero.mp
  rw [← AdjoinRoot.aeval_eq]
  rw [aeval_def, eval₂_map]
  exact hH

/-- A single section for every coefficient-field point, constructed from
divisibility of the actual derivative numerator. -/
theorem polynomial_generic_root_with_sites {k : Type} [Field k] {p : ℕ} [CharP k p]
    (hp : p.Prime) (f : k[X][X]) (hirr : Irreducible (genericEquation f))
    (hprim : f.IsPrimitive) (hpos : f.natDegree ≠ 0) (hf : f.natDegree ≤ 3)
    (hcharY : f.natDegree < p) (t d : ℕ) (ht : Polynomial.Bivariate.degreeX f ≤ t)
    (hd : d < p) (hchar : 10*d*t+t+3*d < p)
    (hdiv : genericEquation f ∣ genericEquation (coordinateNumerator f d)) :
    ∃ q : (AdjoinRoot (genericEquation f))[X], q.natDegree ≤ d ∧
      q.eval (AdjoinRoot.of (genericEquation f) RatFunc.X) = AdjoinRoot.root (genericEquation f) ∧
      ∀ a w : k, (f.map (evalRingHom a)).eval w = 0 →
        q.eval (algebraMap k _ a) = algebraMap k _ w := by
  obtain ⟨q,hq,hv,ha⟩ := polynomial_generic_root hp f hirr hpos hf hcharY t d ht hd hchar hdiv
  let _ : Fact (Irreducible (genericEquation f)) := ⟨hirr⟩
  exact ⟨q, hq, hv, section_at_site _ _ rfl f (generic_root_dvd f hprim) q hv ha⟩

/-- At the second prime, site specialization and the finite incidence count give
either at most 117 scalar labels or an affine head over the original field. -/
theorem component_small_or_head {k F ι : Type} [Field k] [Field F] [DecidableEq F]
    {p : ℕ} [CharP k p] (hp : p.Prime) (f : k[X][X])
    (hirr : Irreducible (genericEquation f)) (hprim : f.IsPrimitive)
    (hpos : f.natDegree ≠ 0) (hf : f.natDegree ≤ 3) (hcharY : f.natDegree < p)
    (t : ℕ) (ht : Polynomial.Bivariate.degreeX f ≤ t) (hd : 67108863 < p)
    (hchar : 10*67108863*t+t+3*67108863 < p)
    (hdiv : genericEquation f ∣ genericEquation (coordinateNumerator f 67108863))
    (φ : F →+* k) (γ : k) (D : Finset ι) (dom : ι ↪ F) (u v : ι → F)
    (M : Finset F) (R : ι → F[X]) (hn : D.card = 1073741824)
    (hdeg : ∀ i ∈ D, (R i).natDegree ≤ 34)
    (hfit : ∀ z ∈ M, 357913943 ≤ (D.filter fun i => (R i).eval z = 0).card)
    (hs : ∀ i ∈ D, R i = 0 →
      (f.map (evalRingHom (φ (dom i)))).eval (φ (u i) + γ*φ (v i)) = 0) :
    M.card ≤ 117 ∨ ∃ A B : F[X], A.natDegree ≤ 67108863 ∧ B.natDegree ≤ 67108863 ∧
      AdjoinRoot.root (genericEquation f) =
        (A.map ((algebraMap k _).comp φ) +
          C (algebraMap k _ γ) * B.map ((algebraMap k _).comp φ)).eval
            (AdjoinRoot.of (genericEquation f) RatFunc.X) := by
  classical
  rcases le_or_gt M.card 117 with h | h
  · exact Or.inl h
  right
  let _ : Fact (Irreducible (genericEquation f)) := ⟨hirr⟩
  obtain ⟨q,hq,hv,hspec⟩ := polynomial_generic_root_with_sites hp f hirr hprim hpos hf hcharY
    t 67108863 ht hd hchar hdiv
  let ιk := algebraMap k (AdjoinRoot (genericEquation f))
  have hmany := SecondPrimeComponentIncidence.secondPrime_identity_sites D M R hn h hdeg hfit
  obtain ⟨A,B,hA,hB,he⟩ := SecondPrimeComponentIncidence.generic_section_is_head
    (ιk.comp φ) (ιk γ) (D.filter fun i => R i = 0) dom u v _ q hq hmany (by
      intro i hi
      obtain ⟨hiD,hRi⟩ := Finset.mem_filter.mp hi
      simpa only [RingHom.comp_apply, map_add, map_mul] using hspec _ _ (hs i hiD hRi))
  exact ⟨A,B,hA,hB,he ▸ hv.symm⟩

end ArkLib.ProximityGap.Frontier.AlgebraicSectionSpecialization

open ArkLib.ProximityGap.Frontier.AlgebraicSectionSpecialization in
#print axioms component_small_or_head
