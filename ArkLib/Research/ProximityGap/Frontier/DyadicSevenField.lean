import ArkLib.Research.ProximityGap.Frontier.DyadicSevenDescent

/-! # Extending the conic and seven-site bounds from the field of a root -/

namespace ProximityGap.DyadicSevenField
open DyadicParityGalois DyadicProjectiveDescent DyadicSevenDescent
variable {K L : Type*} [Field K] [Field L]

/-- The coefficient of a conic with five distinct source sites descends to
the field generated by those sites and their images. -/
theorem conic_lift (φ : K →+* L) {w : K} {z : L} (wz : φ w=z) (bound : NoFive w) : NoFive z := by
  intro q odd B nz det x y injX injY law
  let X (i : Fin 5) := z^(x i)
  let Y (i : Fin 5) := z^(y i)
  have existsDen : ∃ i, X i*Y i+z^q≠0 := by
    by_contra! zero
    have same (i : Fin 5) : (X i)^2=z^q := by
      have eq : B*X i*Y i+X i+Y i+B*z^q=0 := law i
      linear_combination X i*eq-(B*X i+1)*zero i
    have neg (i : Fin 5) (ni : i≠0) : X i= -X 0 :=
      (sq_eq_sq_iff_eq_or_eq_neg.mp ((same i).trans (same 0).symm)).resolve_left (injX.ne ni)
    exact (show (1:Fin 5)≠2 by decide) (injX ((neg 1 (by decide)).trans (neg 2 (by decide)).symm))
  obtain ⟨i,den⟩ := existsDen
  let β := -(w^(x i)+w^(y i))/(w^(x i)*w^(y i)+w^q)
  have coeff : φ β=B := by
    simp only [β,map_div₀,map_neg,map_add,map_mul,map_pow,wz]
    apply (div_eq_iff den).2
    linear_combination -(law i)
  have inj (r : Fin 5 → ℕ) (hr : Function.Injective (fun j => z^(r j))) :
      Function.Injective (fun j => w^(r j)) := fun _ _ e => hr (by simpa only [map_pow,wz] using congrArg φ e)
  apply bound q odd β (fun zero => nz (by simp only [←coeff,zero,map_zero]))
    (fun bad => det (by simpa only [map_mul,map_pow,coeff,wz,map_one] using congrArg φ bad)) x y (inj x injX) (inj y injY)
  intro j
  apply φ.injective
  simpa only [map_mul,map_add,map_pow,coeff,wz,map_zero] using law j

/-- A grid of order below seven cannot supply the seven distinct sources. -/
theorem small {z : K} {n : ℕ} (root : IsPrimitiveRoot z n) (pos : 0<n) (size : n<7) : Rigid z := by
  intro A B injA
  let f (i : Fin 7) : Fin n := ⟨A i%n,Nat.mod_lt _ pos⟩
  have inj : Function.Injective f := by
    intro i j h
    apply injA
    have e := congrArg (fun t : Fin n => z^t.val) h
    simpa only [f,root.eq_orderOf,pow_mod_orderOf] using e
  have bad := Fintype.card_le_of_injective f inj
  simp only [Fintype.card_fin] at bad
  omega

/-- Scalar extension cannot create a non-dihedral projectivity matching seven
points from a subfield. Three distinct pins suffice to descend the matrix. -/
theorem rigid_lift [CharZero L] (φ : K →+* L) {w : K} {z : L} (wz : φ w=z)
    (bound : Rigid w) : Rigid z := by
  intro A B injA injB a b c d det edges
  let f := Fin.castLEEmb (by decide : 3≤7)
  have inj (r : Fin 7 → ℕ) (hr : Function.Injective (fun i => z^(r i))) :
      Function.Injective (fun i => w^(r i)) := fun _ _ e => hr (by simpa only [map_pow,wz] using congrArg φ e)
  let X : Fin 3 ↪ K := ⟨fun i => w^(A (f i)),(inj A injA).comp f.injective⟩
  let Y : Fin 3 ↪ K := ⟨fun i => w^(B (f i)),(inj B injB).comp f.injective⟩
  obtain ⟨P,Q,R,S,hdet,equiv⟩ := field_of_three φ X Y det (by
    intro i
    change Graph a b c d (φ (w^(A (f i)))) (φ (w^(B (f i))))
    simpa only [map_pow,wz] using edges (f i))
  have site (i : Fin 7) : Graph P Q R S (w^(A i)) (w^(B i)) := by
    apply φ.injective
    simpa only [Graph,map_add,map_mul,map_pow,wz] using (equiv _ _).mp (edges i)
  have diag := bound A B (inj A injA) (inj B injB) P Q R S hdet site
  let eval (u : L) := (φ P*u+φ Q)/(φ R*u+φ S)
  have evenSites (u : L) (nu : u≠0) : Graph a b c d u (eval u) ∧ Graph a b c d (-u) (-(eval u)) := by
    have den : φ R*u+φ S≠0 := by
      rcases diag with ⟨hq,hr⟩|⟨hp,hs⟩
      · have ns : S≠0 := by intro h;apply hdet;simp [hr,h]
        simpa only [hr,map_zero,zero_mul,zero_add] using (map_ne_zero φ).2 ns
      · have nr : R≠0 := by intro h;apply hdet;simp [hp,h]
        simpa only [hs,map_zero,add_zero] using mul_ne_zero ((map_ne_zero φ).2 nr) nu
    have base : Graph (φ P) (φ Q) (φ R) (φ S) u (eval u) := (div_mul_cancel₀ _ den).symm
    refine ⟨(equiv _ _).mpr base,(equiv _ _).mpr ?_⟩
    dsimp only [Graph] at base ⊢
    rcases diag with ⟨hq,hr⟩|⟨hp,hs⟩
    · simp only [hq,hr,map_zero,zero_mul,zero_add,add_zero,mul_neg] at base ⊢
      linear_combination -base
    · simp only [hp,hs,map_zero,zero_mul,zero_add,add_zero,mul_neg] at base ⊢
      linear_combination base
  exact two_antipodal det (by norm_num : (1:L)^2≠(2:L)^2) (evenSites 1 one_ne_zero).1
    (evenSites 1 one_ne_zero).2 (evenSites 2 (by norm_num)).1 (evenSites 2 (by norm_num)).2

/-- The conic obstruction at each level, together with parity descent, proves
seven-site rigidity on every dyadic grid in one normal ambient field. -/
theorem normal_orders [CharZero K] [Algebra ℚ K] [Normal ℚ K]
    (conics : ∀ (j : ℕ), 0<j → ∀ w : K, IsPrimitiveRoot w (2^(j+1)) → NoFive w)
    {m : ℕ} {z : K} (root : IsPrimitiveRoot z (2^m)) : Rigid z := by
  induction m generalizing z with
  | zero => exact small root (by decide) (by decide)
  | succ m ih =>
    cases m with
    | zero => exact small root (by decide) (by decide)
    | succ t =>
      cases t with
      | zero => exact small root (by decide) (by decide)
      | succ j =>
        have sqroot : IsPrimitiveRoot (z^2) (2^(j+2)) :=
          IsPrimitiveRoot.pow (by positivity) root (by rw [pow_succ];omega)
        exact step root (ih sqroot) (conics (j+1) (by omega) _ sqroot)

end ProximityGap.DyadicSevenField
#print axioms ProximityGap.DyadicSevenField.conic_lift
#print axioms ProximityGap.DyadicSevenField.rigid_lift
