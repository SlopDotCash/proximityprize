#print axioms ProximityGap.ProjectiveQuotientSupport.mem_vanishOn_iff
#print axioms ProximityGap.ProjectiveQuotientSupport.quotientPencil_le_iff
#print axioms
  ProximityGap.ProjectiveQuotientSupport.quotient_mk_mem_quotientSupportSubmodule_iff
#print axioms ProximityGap.ProjectiveQuotientSupport.pairJointAgreesOn_iff_quotientSupport
#print axioms ProximityGap.ProjectiveQuotientSupport.mcaEventProj_iff_quotientSupport
#print axioms
  ProximityGap.ProjectiveQuotientSupport.mcaEventProj_iff_quotientPencilSupport
