import ArkLib.Data.CodingTheory.ProximityGap.CumulantGaussPeriodBound

/-!
# The EXACT structured-prime obstruction to the moment proof (#407, A-core)

This sharpens `CumulantGaussPeriodBound.not_cumulantBound_of_excess`.  That lemma records that a
cumulant excess refutes `CumulantEnergyBound` at a single order `r`.  The probe observation
(`scripts/probes/prize_workspace.py`, **not** kernel-checked) is a consumer-level failure: at the
Fermat prime `p = 65537 = 2^16 + 1` with `n = 64 = 2^6`, the probe's optimised worst-far-period
moment certificate `min_r (q·(2r-1)‼·n^r)^{1/(2r)} ≈ 38.27` falls below the probe-measured period
max `M = max_{b≠0}‖η_b‖ ≈ 43.633`.  If those probe values are right, the Wick-shaped moment
certificate cannot certify `M` at any order `r` in that family.  This says nothing about other
moment inputs (e.g. a weaker energy bound) or about all moment methods.

## What is kernel-checked here, and what is not (audit 2026-10-28, PG-078)

* `MomentCertificateBelowM` — the abstract obstruction predicate.
* `cumulantBound_false_of_certificate_below_M` — if the order-`r` certificate is below a realised far
  period `‖η_b‖`, then `CumulantEnergyBound G r` is FALSE (per-frequency sharpening of
  `not_cumulantBound_of_excess`).  Generic and conditional; valid.
* `not_cumulantBound_two_of_card_energy` — the genuine formal bridge: any `G` in a field with
  `65537` elements with `|G| = 64` and `rEnergy G 2 = 19776` violates `CumulantEnergyBound G 2`.
  The energy value is a hypothesis.
* `fermat65537_n64_r2_excess`, `fermat65537_n64_certificate_below_M_numeric`,
  `fermat_resonance_strictly_higher` — **arithmetic sanity checks on probe-derived constants only.**
  Their statements are bare numeric inequalities (`65537·(3·64²) < 65537·19776 − 64⁴`,
  `38.27 < 43.63`, `1.53 < 2.682`); they mention no subgroup, energy, Gauss period, optimisation
  over `r`, or prime family, and they do not certify those interpretations.

Not formalized: the order-64 subgroup of `F₆₅₅₃₇` (generated by `8224`) as a `Finset`, its
cardinality, and the identity `E₂ = 19776` (independently recomputed by an exact Python convolution
during the audit, so the value is not in doubt — only its formal identification is missing); and
any rigorous realised-period or certificate bound.

**Honest scope.**  Localisation evidence, not a closure and not a kernel-certified concrete
refutation: the Wick-shaped moment certificate appears to be the wrong tool at the structured
(Fermat) primes.  Issue #407.  Axiom-clean (`propext, Classical.choice, Quot.sound`).
-/

open ArkLib.ProximityGap.SubgroupGaussSumSecondMoment
open ArkLib.ProximityGap.SubgroupGaussSumMoment
open ArkLib.ProximityGap.InteriorWorstCaseIncompleteSum
open ArkLib.ProximityGap.GaussPeriodMomentBound
open ArkLib.ProximityGap.CumulantGaussPeriodBound

namespace ArkLib.ProximityGap.CumulantFermatObstruction

variable {F : Type*} [Field F] [Fintype F] [DecidableEq F]

/-- **The abstract obstruction predicate.**  The order-`r` cumulant certificate for the SQUARED
period, `(q·(2r-1)‼·n^r)^{1/r}` (the exact scale of `worstCaseIncompleteSumBound_of_cumulantBound`),
is strictly below the realised squared far period `‖η_b‖²`.  When this holds the moment method, at
order `r`, cannot certify the true worst-case period. -/
def MomentCertificateBelowM (ψ : AddChar F ℂ) (G : Finset F) (r : ℕ) (b : F) : Prop :=
  ((Fintype.card F : ℝ) * (Nat.doubleFactorial (2 * r - 1) : ℝ) * (G.card : ℝ) ^ r)
      ^ ((r : ℝ)⁻¹) < ‖eta ψ G b‖ ^ 2

/-- **The moment proof fails (consumer-level refutation).**  If a single FAR period (`b ≠ 0`) has its
square `‖η_b‖²` exceeding the order-`r` cumulant certificate `(q·(2r-1)‼·n^r)^{1/r}`, then
`CumulantEnergyBound G r` is FALSE.  Contrapositive of `worstCaseIncompleteSumBound_of_cumulantBound`
read at the single frequency `b`.  Sharper than `not_cumulantBound_of_excess` (it uses one realised
period, not the full cumulant sum). -/
theorem cumulantBound_false_of_certificate_below_M
    {ψ : AddChar F ℂ} (hψ : ψ.IsPrimitive) {G : Finset F} {r : ℕ} (hr : 1 ≤ r) {b : F} (hb : b ≠ 0)
    (hbelow : MomentCertificateBelowM ψ G r b) :
    ¬ CumulantEnergyBound G r := by
  intro hbound
  set X : ℝ := (Fintype.card F : ℝ) * (Nat.doubleFactorial (2 * r - 1) : ℝ) * (G.card : ℝ) ^ r
    with hXdef
  -- the cumulant input gives (‖η_b‖²)^r ≤ X, i.e. ‖η_b‖² ≤ X^{1/r}
  have hpow : (‖eta ψ G b‖ ^ 2) ^ r ≤ X := by
    rw [← pow_mul]; exact eta_pow_le_of_cumulantBound hψ hbound hb
  have hle : ‖eta ψ G b‖ ^ 2 ≤ X ^ ((r : ℝ)⁻¹) :=
    calc ‖eta ψ G b‖ ^ 2
        = ((‖eta ψ G b‖ ^ 2) ^ r) ^ ((r : ℝ)⁻¹) :=
          (Real.pow_rpow_inv_natCast (sq_nonneg _) (Nat.one_le_iff_ne_zero.mp hr)).symm
      _ ≤ X ^ ((r : ℝ)⁻¹) := Real.rpow_le_rpow (by positivity) hpow (by positivity)
  have hbelow' : X ^ ((r : ℝ)⁻¹) < ‖eta ψ G b‖ ^ 2 := hbelow
  exact absurd hle (not_le_of_gt hbelow')

/-- **Arithmetic sanity check (probe-derived constant).**  The probe value
`E₂(μ₆₄ ⊂ F₆₅₅₃₇) = 19776` would violate `CumulantEnergyBound` at `r=2`, which reads
`q·E₂ − n⁴ ≤ q·3·n²`: `65537·19776 − 64⁴ = 1279282496 > 805318656 = 65537·3·64²`.  This theorem
proves only that integer inequality; it does not mention a subgroup or its energy.  The formal
bridge from an energy value to the refutation is `not_cumulantBound_two_of_card_energy`. -/
theorem fermat65537_n64_r2_excess :
    (65537 : ℤ) * (3 * 64 ^ 2) < (65537 : ℤ) * 19776 - 64 ^ 4 := by norm_num

/-- **Conditional concrete refutation at `r = 2`.**  In any finite field with `65537` elements,
a set `G` with `|G| = 64` and `rEnergy G 2 = 19776` violates `CumulantEnergyBound G 2`.  The
order-64 subgroup of `F₆₅₅₃₇` is probe-measured (and audit-recomputed) to have this energy; that
identification is a hypothesis here, not a kernel-checked fact. -/
theorem not_cumulantBound_two_of_card_energy {G : Finset F} (hq : Fintype.card F = 65537)
    (hG : G.card = 64) (hE : rEnergy G 2 = 19776) :
    ¬ CumulantEnergyBound G 2 := by
  apply not_cumulantBound_of_excess
  rw [hq, hG, hE]
  norm_num [Nat.doubleFactorial]

/-- **Arithmetic sanity check (probe-derived constants).**  The probe reports an optimised moment
certificate `≈ 38.27` and a measured period max `M ≈ 43.633`.  This theorem proves only the decimal
inequality `38.27 < 43.63`; it certifies neither the character-period maximum nor the
optimisation over `r`. -/
theorem fermat65537_n64_certificate_below_M_numeric :
    (38.27 : ℝ) < (43.63 : ℝ) := by norm_num

/-- **Arithmetic sanity check (probe-derived constants).**  The probe reports `(M²/n)/ln p ≈ 2.682`
at the Fermat prime `p = 65537` versus `≤ 1.53` for the strongest probed high-`v₂(p−1)` non-Fermat
prime.  This theorem proves only the decimal inequality `1.53 < 2.682`; it is not a comparison
across prime families. -/
theorem fermat_resonance_strictly_higher :
    (1.53 : ℝ) < (2.682 : ℝ) := by norm_num

end ArkLib.ProximityGap.CumulantFermatObstruction

