theorem fingerprintNat_lt_prime : forall i, fingerprintNat i < P := by decide

theorem fingerprintNat_injective : Function.Injective fingerprintNat := by decide

/-- The same table, regarded as elements of the certified field. -/
def fingerprint : Fin 93 -> ZMod P := fun i => fingerprintNat i

theorem fingerprint_injective : Function.Injective fingerprint := by
  decide

local instance localInstance_RateHalfBaseFingerprintTable_1 : Fact (Nat.Prime P) := ⟨prime_P⟩

/-- Identifying the two chart coordinates with the table is sufficient to
prove full projective separation of the 93 base directions. -/
theorem projectively_separated_of_chart
    (direction : Fin 93 -> Fin 64 -> ZMod P)
    (h6 : forall i, direction i 6 ≠ 0)
    (hchart : forall i, direction i 15 / direction i 6 = fingerprint i) :
    forall i j, (exists c : ZMod P, direction i = c • direction j) -> i = j := by
  intro i j hproj
  apply fingerprint_injective
  rw [← hchart i, ← hchart j]
  obtain ⟨c, hc⟩ := hproj
  have h6eq := congrFun hc (6 : Fin 64)
  have h15eq := congrFun hc (15 : Fin 64)
  simp only [Pi.smul_apply, smul_eq_mul] at h6eq h15eq
  rw [h6eq, h15eq]
  have hcne : c ≠ 0 := by
    intro hc0
    rw [hc0, zero_mul] at h6eq
    exact h6 i h6eq
  field_simp

/-- Once the chart is evaluated, the 93-by-`m` Vandermonde lift is
projectively injective without any further finite-field computation. -/
theorem lifted_projectively_separated_of_chart
    (direction : Fin 93 -> Fin 64 -> ZMod P)
    (h6 : forall i, direction i 6 ≠ 0)
    (hchart : forall i, direction i 15 / direction i 6 = fingerprint i)
    (m : Nat) (hm : 2 ≤ m) :
    forall (i j : Fin 93) (x y c : ZMod P),
      RankOneTensorProjectiveInjection.outer
          (direction i) (RankOneTensorProjectiveInjection.vandermonde m x) =
        c • RankOneTensorProjectiveInjection.outer
          (direction j) (RankOneTensorProjectiveInjection.vandermonde m y) ->
        i = j ∧ x = y := by
  apply RankOneTensorProjectiveInjection.outer_vandermonde_projectively_injective
    m hm direction
  · intro i hi
    have := congrFun hi (6 : Fin 64)
    exact h6 i this
  · exact projectively_separated_of_chart direction h6 hchart

