import Mathlib.Algebra.Polynomial.Inductions
import Mathlib.Algebra.Polynomial.Roots
import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots

/-!
# Sums of a polynomial over the roots of unity

Let `ζ` be a primitive `n`-th root of unity, so that `ζ ^ 0, …, ζ ^ (n - 1)` is the
multiplicative subgroup of order `n`, with vanishing polynomial `X ^ n - 1`. This file sums a
polynomial over that subgroup, which is the algebra behind the univariate sumcheck of
[BCRSVW19], used by Aurora, Marlin, and Varuna.

## Main results

* `IsPrimitiveRoot.sum_pow_pow`: the power sum `∑ i < n, (ζ ^ i) ^ k` is `n` when `n ∣ k` and
  `0` otherwise.
* `IsPrimitiveRoot.sum_eval`: the sum of `f` over the subgroup collects `n` times the
  coefficients of `f` at multiples of `n`.
* `IsPrimitiveRoot.sum_eval_of_natDegree_lt`: below degree `n`, the sum is `n * f.coeff 0`.
* `IsPrimitiveRoot.sum_eval_eq_mul_coeff_modByMonic`: in general, the sum is `n` times the
  constant coefficient of `f %ₘ (X ^ n - 1)`.
* `IsPrimitiveRoot.sum_eval_eq_iff`: the univariate sumcheck. The sum is `σ` iff
  `f %ₘ (X ^ n - 1) = X * g + C (σ / n)` with `g.degree < n - 1`.
* `IsPrimitiveRoot.X_pow_sub_one_dvd_iff`: `X ^ n - 1` divides `f` iff `f` vanishes on the
  subgroup.

## References

* [Ben-Sasson, E., Chiesa, A., Riabzev, M., Spooner, N., Virza, M., Ward, N. P.,
  *Aurora: Transparent Succinct Arguments for R1CS*][BCRSVW19]
-/

section

open Finset Polynomial

namespace IsPrimitiveRoot

/-! ## Over a domain -/

section Domain

variable {R : Type*} [CommRing R] {ζ : R} {n : ℕ}

/-- The vanishing polynomial `X ^ n - 1` of the subgroup of order `n` is monic. -/
theorem X_pow_sub_one_monic [Nontrivial R] (hn : 0 < n) : (X ^ n - 1 : R[X]).Monic :=
  monic_X_pow_sub_C 1 hn.ne'

/-- The vanishing polynomial is zero on the subgroup. -/
theorem eval_X_pow_sub_one (hζ : IsPrimitiveRoot ζ n) (i : ℕ) :
    (X ^ n - 1 : R[X]).eval (ζ ^ i) = 0 := by
  rw [eval_sub, eval_pow, eval_X, eval_one, ← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow,
    sub_self]

/-- On the subgroup, `f` agrees with its remainder modulo `X ^ n - 1`. -/
theorem eval_modByMonic_X_pow_sub_one (hζ : IsPrimitiveRoot ζ n) (f : R[X]) (i : ℕ) :
    (f %ₘ (X ^ n - 1)).eval (ζ ^ i) = f.eval (ζ ^ i) := by
  conv_rhs => rw [← modByMonic_add_div f (X ^ n - 1)]
  rw [eval_add, eval_mul, hζ.eval_X_pow_sub_one, zero_mul, add_zero]

variable [IsDomain R]

/-- The `k`-th power sum over the subgroup generated by a primitive `n`-th root of unity is `n`
when `n ∣ k`, and `0` otherwise. -/
theorem sum_pow_pow (hζ : IsPrimitiveRoot ζ n) (k : ℕ) :
    ∑ i ∈ range n, (ζ ^ i) ^ k = if n ∣ k then (n : R) else 0 := by
  simp_rw [← pow_mul, mul_comm _ k, pow_mul]
  split_ifs with hdiv
  · simp [(hζ.pow_eq_one_iff_dvd k).2 hdiv]
  · have hne : ζ ^ k ≠ 1 := mt (hζ.pow_eq_one_iff_dvd k).1 hdiv
    have hpow : (ζ ^ k) ^ n = 1 := by rw [← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow]
    have h := mul_geom_sum (ζ ^ k) n
    rw [hpow, sub_self] at h
    exact (mul_eq_zero.1 h).resolve_left (sub_ne_zero.2 hne)

/-- The sum of `f` over the subgroup generated by a primitive `n`-th root of unity is `n` times
the sum of the coefficients of `f` at multiples of `n`. -/
theorem sum_eval (hζ : IsPrimitiveRoot ζ n) (f : R[X]) :
    ∑ i ∈ range n, f.eval (ζ ^ i) =
      ∑ m ∈ f.support, f.coeff m * if n ∣ m then (n : R) else 0 := by
  simp_rw [eval_eq_sum, Polynomial.sum_def]
  rw [sum_comm]
  exact sum_congr rfl fun m _ => by rw [← mul_sum, hζ.sum_pow_pow]

/-- Below degree `n`, the sum of `f` over the subgroup is `n * f.coeff 0`. -/
theorem sum_eval_of_natDegree_lt (hζ : IsPrimitiveRoot ζ n) {f : R[X]} (hf : f.natDegree < n) :
    ∑ i ∈ range n, f.eval (ζ ^ i) = n * f.coeff 0 := by
  rw [hζ.sum_eval]
  have hterm : ∀ m ∈ f.support,
      (f.coeff m * if n ∣ m then (n : R) else 0) = if m = 0 then n * f.coeff m else 0 := by
    intro m hm
    rcases Nat.eq_zero_or_pos m with rfl | hm0
    · simp [mul_comm]
    · have hndvd : ¬n ∣ m := fun h =>
        (hf.trans_le' (le_natDegree_of_mem_supp m hm)).not_ge (Nat.le_of_dvd hm0 h)
      simp [hm0.ne', hndvd]
  rw [sum_congr rfl hterm, sum_ite_eq']
  split_ifs with hmem
  · rfl
  · simp [notMem_support_iff.1 hmem]

/-- A remainder modulo `X ^ n - 1` has degree below `n`. -/
theorem natDegree_modByMonic_X_pow_sub_one_lt (hn : 0 < n) (f : R[X]) :
    (f %ₘ (X ^ n - 1)).natDegree < n := by
  have hdeg : (X ^ n - 1 : R[X]).natDegree = n := by rw [← C_1, natDegree_X_pow_sub_C]
  have h := natDegree_modByMonic_lt f (X_pow_sub_one_monic hn) fun h => by
    have h' := congrArg natDegree h
    rw [hdeg, natDegree_one] at h'
    omega
  rwa [hdeg] at h

/-- The sum of `f` over the subgroup is `n` times the constant coefficient of its remainder
modulo `X ^ n - 1`. -/
theorem sum_eval_eq_mul_coeff_modByMonic (hζ : IsPrimitiveRoot ζ n) (hn : 0 < n) (f : R[X]) :
    ∑ i ∈ range n, f.eval (ζ ^ i) = n * (f %ₘ (X ^ n - 1)).coeff 0 := by
  rw [← hζ.sum_eval_of_natDegree_lt (natDegree_modByMonic_X_pow_sub_one_lt hn f)]
  exact sum_congr rfl fun i _ => (hζ.eval_modByMonic_X_pow_sub_one f i).symm

/-- `X ^ n - 1` divides `f` iff `f` vanishes on the subgroup generated by a primitive `n`-th
root of unity. -/
theorem X_pow_sub_one_dvd_iff (hζ : IsPrimitiveRoot ζ n) (hn : 0 < n) {f : R[X]} :
    X ^ n - 1 ∣ f ↔ ∀ i < n, f.eval (ζ ^ i) = 0 := by
  refine ⟨fun ⟨g, hg⟩ i _ => by rw [hg, eval_mul, hζ.eval_X_pow_sub_one, zero_mul], fun h => ?_⟩
  rw [← modByMonic_eq_zero_iff_dvd (X_pow_sub_one_monic hn)]
  refine eq_zero_of_natDegree_lt_card_of_eval_eq_zero _ (f := fun i : Fin n => ζ ^ (i : ℕ))
    (fun i j hij => Fin.ext (hζ.pow_inj i.2 j.2 hij)) (fun i => ?_) ?_
  · rw [hζ.eval_modByMonic_X_pow_sub_one]
    exact h i i.2
  · simpa using natDegree_modByMonic_X_pow_sub_one_lt hn f

end Domain

/-! ## The univariate sumcheck -/

section Field

variable {F : Type*} [Field F] {ζ : F} {n : ℕ}

/-- The univariate sumcheck of [BCRSVW19]: the sum of `f` over the subgroup generated by a
primitive `n`-th root of unity is `σ` iff the remainder of `f` modulo `X ^ n - 1` is
`X * g + σ / n` for some `g` of degree below `n - 1`. -/
theorem sum_eval_eq_iff (hζ : IsPrimitiveRoot ζ n) (hn : 0 < n) (f : F[X]) (σ : F) :
    ∑ i ∈ range n, f.eval (ζ ^ i) = σ ↔
      ∃ g : F[X], g.degree < ↑(n - 1) ∧ f %ₘ (X ^ n - 1) = X * g + C (σ / n) := by
  have : NeZero n := ⟨hn.ne'⟩
  have hn0 : (n : F) ≠ 0 := hζ.neZero'.out
  rw [hζ.sum_eval_eq_mul_coeff_modByMonic hn]
  set r := f %ₘ (X ^ n - 1)
  constructor
  · intro hσ
    refine ⟨r.divX, ?_, ?_⟩
    · by_cases hr : r = 0
      · simp [hr]
      · have hlt : r.natDegree < n := natDegree_modByMonic_X_pow_sub_one_lt hn f
        refine (degree_divX_lt hr).trans_le (degree_le_natDegree.trans ?_)
        exact_mod_cast (by omega : r.natDegree ≤ n - 1)
    · rw [← hσ, mul_div_cancel_left₀ _ hn0, X_mul_divX_add]
  · rintro ⟨g, -, hg⟩
    rw [hg, coeff_add, coeff_X_mul_zero, coeff_C_zero, zero_add, mul_div_cancel₀ _ hn0]

end Field

end IsPrimitiveRoot

end

